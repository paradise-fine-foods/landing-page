---
import SiteLayout from '@/layouts/SiteLayout.astro';
import LivingHero from '@/components/sections/LivingHero.astro';
import CredibilityStrip from '@/components/sections/CredibilityStrip.astro';
import CategoryDiscovery from '@/components/sections/CategoryDiscovery.astro';
import FeaturedProducts from '@/components/sections/FeaturedProducts.astro';
import FeaturedBrands from '@/components/sections/FeaturedBrands.astro';
import LatestBlogs from '@/components/blogs/LatestBlogs.astro';
import LatestRecipes from '@/components/recipes/LatestRecipes.astro';
import ServiceProof from '@/components/sections/ServiceProof.astro';
import ChannelPathways from '@/components/sections/ChannelPathways.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import PartnerStrip from '@/components/sections/PartnerStrip.astro';
import { getBrands, getCategories, getFeaturedContent, getGlobalSettings, getLatestBlogPosts, getLatestRecipes, getProducts } from '@/lib/cms/queries';
import { localizedPath } from '@/lib/i18n/routes';
import { counterpartLocale } from '@/lib/i18n/static-paths';
import { isLocale } from '@/lib/i18n/types';
import { ui } from '@/lib/i18n/ui';
import { loadCmsPageData, markNotFound } from '@/lib/cms/page-state';

const localeParam = Astro.params.locale;
if (!localeParam || !isLocale(localeParam)) {
  markNotFound(Astro.response);
  return Astro.rewrite('/404');
}
const locale = localeParam;
const pathname = localizedPath(locale, 'home');
const alternatePath = localizedPath(counterpartLocale(locale), 'home');
const pageData = await loadCmsPageData(
  () => getGlobalSettings(locale),
  () => getFeaturedContent(locale),
  () => getCategories(locale),
  () => getProducts(locale, {}),
  () => getBrands(locale),
  () => getLatestBlogPosts(locale, 3),
  () => getLatestRecipes(locale, 3),
);
if (!pageData.ok) return Astro.rewrite('/503');
const [settings, featured, categories, products, brands, latestBlogs, latestRecipes] = pageData.data;
const copy = ui[locale];
const productsPath = localizedPath(locale, 'products');
const contactPath = localizedPath(locale, 'contact');
const categoryCounts = Object.fromEntries(categories.map((category) => [category.id, products.filter((product) => product.categories.some(({ id }) => id === category.id)).length]));
const selectedBrand = brands.find(({ id }) => id === featured.hero.product.brand.id) ?? featured.hero.product.brand;
const selectedBrandProducts = products.filter((product) => product.brand.id === selectedBrand.id).slice(0, 3);
const remainingBrands = brands.filter(({ id }) => id !== selectedBrand.id);
const preloadImages = [{ href: featured.hero.image.src }];
const channels = [
  { ...copy.home.channels.retail, href: `${contactPath}?interest=retail` },
  { ...copy.home.channels.horeca, href: `${contactPath}?interest=horeca` },
  { ...copy.home.channels.bakery, href: `${contactPath}?interest=bakery` },
  { ...copy.home.channels.ecommerce, href: `${contactPath}?interest=ecommerce` },
];
---

<SiteLayout locale={locale} title={settings.siteName} description={settings.siteDescription} {pathname} {alternatePath} settings={settings} image={featured.hero.image.src} {preloadImages}>
  <LivingHero copy={copy.hero} content={featured.hero} {productsPath} {contactPath} />
  <CredibilityStrip title={copy.home.credibilityTitle} pillars={copy.home.operationalPillars} />
  <CategoryDiscovery eyebrow={copy.home.categoryEyebrow} title={copy.home.categoryTitle} description={copy.home.categoryDescription} {categories} {categoryCounts} productLabel={copy.home.categoryProductLabel} {productsPath} />
  <FeaturedProducts eyebrow={copy.home.featuredProductsEyebrow} title={copy.home.featuredProductsTitle} products={products.filter((product) => product.featured)} locale={locale} carousel={copy.home.carousel} />
  <FeaturedBrands eyebrow={copy.home.featuredBrandsEyebrow} title={copy.home.featuredBrandsTitle} {selectedBrand} {selectedBrandProducts} {remainingBrands} locale={locale} />
  <LatestBlogs posts={latestBlogs} {locale} eyebrow={copy.home.latestBlogsEyebrow} title={copy.home.latestBlogsTitle} viewAllLabel={copy.home.latestBlogsViewAll} />
  <LatestRecipes posts={latestRecipes} {locale} eyebrow={copy.home.latestRecipesEyebrow} title={copy.home.latestRecipesTitle} viewAllLabel={copy.home.latestRecipesViewAll} />
  <PartnerStrip eyebrow={copy.home.partnersEyebrow} title={copy.home.partnersTitle} partners={settings.partners} />
  <ServiceProof eyebrow={copy.home.serviceEyebrow} title={copy.home.serviceTitle} description={copy.home.serviceDescription} temperatureLabel={copy.home.serviceTemperatureLabel} pillars={copy.home.operationalPillars} editorial={featured.editorial} />
  <ChannelPathways eyebrow={copy.home.channelsEyebrow} title={copy.home.channelsTitle} {channels} />
  <FinalCta title={copy.home.finalCtaTitle} description={copy.home.finalCtaDescription} button={copy.home.finalCtaButton} href={contactPath} />
</SiteLayout>
