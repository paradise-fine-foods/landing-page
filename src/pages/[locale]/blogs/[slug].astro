---
import BlogArticle from '../../../components/blogs/BlogArticle.astro';
import LatestBlogs from '../../../components/blogs/LatestBlogs.astro';
import Breadcrumbs from '../../../components/global/Breadcrumbs.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { blogDetailPath } from '../../../lib/blogs/routes';
import { getBlogPostBySlug, getBlogPosts, getGlobalSettings, getLatestBlogPosts } from '../../../lib/cms/queries';
import { loadCmsPageData, markNotFound } from '../../../lib/cms/page-state';
import { localizedPath } from '../../../lib/i18n/routes';
import { counterpartLocale } from '../../../lib/i18n/static-paths';
import { isLocale } from '../../../lib/i18n/types';
import { ui } from '../../../lib/i18n/ui';

const localeParam = Astro.params.locale;
const slug = Astro.params.slug;
if (!localeParam || !isLocale(localeParam) || !slug) {
  markNotFound(Astro.response);
  return Astro.rewrite('/404');
}
const locale = localeParam;
const alternateLocale = counterpartLocale(locale);
const primaryData = await loadCmsPageData(
  () => getGlobalSettings(locale),
  () => getBlogPostBySlug(locale, slug),
);
if (!primaryData.ok) return Astro.rewrite('/503');
const [settings, post] = primaryData.data;
if (!post) {
  markNotFound(Astro.response);
  return Astro.rewrite('/404');
}
const secondaryData = await loadCmsPageData(
  () => getBlogPosts(alternateLocale),
  () => getLatestBlogPosts(locale, 3, post.id),
);
if (!secondaryData.ok) return Astro.rewrite('/503');
const [counterpartPosts, suggestions] = secondaryData.data;
const counterpart = counterpartPosts.find(({ id }) => id === post.id);
const pathname = blogDetailPath(locale, post);
const alternatePath = counterpart
  ? blogDetailPath(alternateLocale, counterpart)
  : localizedPath(alternateLocale, 'blogs');
const copy = ui[locale];
---

<SiteLayout {locale} title={`${post.title} | ${settings.siteName}`} description={post.excerpt} {pathname} {alternatePath} settings={settings} image={post.image.src}>
  <div class="blog-page container section-space">
    <Breadcrumbs label={copy.blog.breadcrumb} items={[{ label: copy.header.home, href: localizedPath(locale, 'home') }, { label: copy.header.blogs, href: localizedPath(locale, 'blogs') }, { label: post.title }]} />
    <BlogArticle {post} {locale} />
  </div>
  <LatestBlogs posts={suggestions} {locale} eyebrow={copy.blog.latestEyebrow} title={copy.blog.latestTitle} viewAllLabel={copy.blog.viewAll} />
</SiteLayout>

<style>.blog-page { min-inline-size: 0; }</style>
