---
import BrandDetail from '../../../components/brands/BrandDetail.astro';
import Breadcrumbs from '../../../components/global/Breadcrumbs.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { brandDetailPath } from '../../../lib/brands/routes';
import { getBrandBySlug, getGlobalSettings, getProducts } from '../../../lib/cms/queries';
import { loadCmsPageData, markNotFound } from '../../../lib/cms/page-state';
import { localizedPath } from '../../../lib/i18n/routes';
import { isLocale } from '../../../lib/i18n/types';
import { ui } from '../../../lib/i18n/ui';

const localeParam = Astro.params.locale;
const slug = Astro.params.slug;
if (!localeParam || !isLocale(localeParam) || !slug) {
  markNotFound(Astro.response);
  return Astro.rewrite('/404');
}
const locale = localeParam;
const pageData = await loadCmsPageData(async () => {
  const [settings, brand, allProducts] = await Promise.all([
    getGlobalSettings(locale), getBrandBySlug(locale, slug), getProducts(locale),
  ]);
  return { settings, brand, allProducts };
});
if (!pageData.ok) return Astro.rewrite('/503');
const { settings, brand, allProducts } = pageData.data;
if (!brand) {
  markNotFound(Astro.response);
  return Astro.rewrite('/404');
}
const products = allProducts.filter((product) => product.brand.id === brand.id);
const pathname = brandDetailPath(locale, brand);
const alternatePath = brand.counterpart
  ? brandDetailPath(brand.counterpart.locale, brand.counterpart)
  : undefined;
const copy = ui[locale];
---

<SiteLayout {locale} title={`${brand.name} | ${settings.siteName}`} description={brand.description} {pathname} {alternatePath} settings={settings} image={brand.image.src}>
  <div class="brand-page container section-space">
    <Breadcrumbs label={copy.brand.breadcrumb} items={[{ label: copy.header.home, href: localizedPath(locale, 'home') }, { label: copy.header.brands, href: localizedPath(locale, 'brands') }, { label: brand.name }]} />
    <BrandDetail {brand} {products} {locale} {copy} />
  </div>
</SiteLayout>

<style>.brand-page { min-inline-size: 0; }</style>
