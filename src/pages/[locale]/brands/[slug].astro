---
import BrandDetail from '../../../components/brands/BrandDetail.astro';
import Breadcrumbs from '../../../components/global/Breadcrumbs.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { brandDetailPath } from '../../../lib/brands/routes';
import { getBrandBySlug, getBrands, getProducts } from '../../../lib/cms/queries';
import { localizedPath } from '../../../lib/i18n/routes';
import { counterpartLocale } from '../../../lib/i18n/static-paths';
import { isLocale } from '../../../lib/i18n/types';
import { ui } from '../../../lib/i18n/ui';

const localeParam = Astro.params.locale;
const slug = Astro.params.slug;
if (!localeParam || !isLocale(localeParam) || !slug) return Astro.rewrite('/404');
const locale = localeParam;
const brand = await getBrandBySlug(locale, slug);
if (!brand) return Astro.rewrite('/404');
const alternateLocale = counterpartLocale(locale);
const [allProducts, counterpartBrands] = await Promise.all([
  getProducts(locale),
  getBrands(alternateLocale),
]);
const products = allProducts.filter((product) => product.brand.id === brand.id);
const counterpart = counterpartBrands.find(({ id }) => id === brand.id);
const pathname = brandDetailPath(locale, brand);
const alternatePath = counterpart
  ? brandDetailPath(alternateLocale, counterpart)
  : localizedPath(alternateLocale, 'brands');
const copy = ui[locale];
---

<SiteLayout {locale} title={`${brand.name} | ${copy.siteName}`} description={brand.description} {pathname} {alternatePath} siteName={copy.siteName} image={brand.image.src}>
  <div class="brand-page container section-space">
    <Breadcrumbs label={copy.brand.breadcrumb} items={[{ label: copy.header.home, href: localizedPath(locale, 'home') }, { label: copy.header.brands, href: localizedPath(locale, 'brands') }, { label: brand.name }]} />
    <BrandDetail {brand} {products} {locale} {copy} />
  </div>
</SiteLayout>

<style>.brand-page { min-inline-size: 0; }</style>
