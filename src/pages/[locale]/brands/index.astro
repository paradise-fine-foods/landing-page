---
import BrandCard from '../../../components/brands/BrandCard.astro';
import Breadcrumbs from '../../../components/global/Breadcrumbs.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { getBrands, getGlobalSettings } from '../../../lib/cms/queries';
import { loadCmsPageData, markNotFound } from '../../../lib/cms/page-state';
import { localizedPath } from '../../../lib/i18n/routes';
import { counterpartLocale } from '../../../lib/i18n/static-paths';
import { isLocale } from '../../../lib/i18n/types';
import { ui } from '../../../lib/i18n/ui';

const localeParam = Astro.params.locale;
if (!localeParam || !isLocale(localeParam)) {
  markNotFound(Astro.response);
  return Astro.rewrite('/404');
}
const locale = localeParam;
const pathname = localizedPath(locale, 'brands');
const alternatePath = localizedPath(counterpartLocale(locale), 'brands');
const pageData = await loadCmsPageData(
  () => getGlobalSettings(locale),
  () => getBrands(locale),
);
if (!pageData.ok) return Astro.rewrite('/503');
const [settings, brands] = pageData.data;
const copy = ui[locale];
---

<SiteLayout {locale} title={`${copy.brand.title} | ${settings.siteName}`} description={copy.brand.description} {pathname} {alternatePath} settings={settings}>
  <div class="brands-page container section-space">
    <Breadcrumbs label={copy.brand.breadcrumb} items={[{ label: copy.header.home, href: localizedPath(locale, 'home') }, { label: copy.header.brands }]} />
    <header class="brands-page__intro">
      <p>{copy.brand.eyebrow}</p>
      <h1>{copy.brand.title}</h1>
      <p>{copy.brand.description}</p>
    </header>
    {brands.length > 0 ? (
      <section aria-label={copy.brand.title} class="brands-page__grid">
        {brands.map((brand, index) => <BrandCard {brand} {locale} index={index + 1} headingLevel="h2" />)}
      </section>
    ) : (
      <section class="brands-page__empty"><h2>{copy.brand.emptyTitle}</h2><p>{copy.brand.emptyDescription}</p></section>
    )}
  </div>
</SiteLayout>

<style>
  .brands-page { min-inline-size: 0; }
  .brands-page__intro { display: grid; gap: var(--space-5); grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr); padding-block: var(--space-6) var(--space-8); }
  .brands-page__intro > p:first-child { color: var(--color-utility-grey); font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .brands-page__intro h1 { font-size: var(--text-hero); max-inline-size: 13ch; }
  .brands-page__intro > p:last-child { font-size: var(--text-lg); grid-column: 2; max-inline-size: var(--measure); }
  .brands-page__grid { display: grid; }
  .brands-page__empty { border-block: 1px solid var(--color-brushed-steel); display: grid; gap: var(--space-3); padding-block: var(--space-7); }
  @media (max-width: 42rem) { .brands-page__intro { grid-template-columns: minmax(0, 1fr); } .brands-page__intro > p:last-child { grid-column: auto; } }
</style>
