---
import RecipeArticle from '@/components/recipes/RecipeArticle.astro';
import RecipeSuggestionsIsland from '@/components/recipes/RecipeSuggestionsIsland.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { recipeAlternatePath, recipeDetailPath, loadRecipeDetailPageData } from '@/lib/recipes/routes';
import { markNotFound } from '@/lib/cms/page-state';
import { localizedPath } from '@/lib/i18n/routes';
import { isLocale } from '@/lib/i18n/types';
import { ui } from '@/lib/i18n/ui';

const localeParam = Astro.params.locale;
const slug = Astro.params.slug;
if (!localeParam || !isLocale(localeParam) || !slug) {
  markNotFound(Astro.response);
  return Astro.rewrite('/404');
}
const locale = localeParam;
const pageData = await loadRecipeDetailPageData(locale, slug);
if (pageData.status === 503) return Astro.rewrite('/503');
if (pageData.status === 404) {
  markNotFound(Astro.response);
  return Astro.rewrite('/404');
}
const { settings, recipe } = pageData;
const pathname = recipeDetailPath(locale, recipe);
const alternatePath = recipeAlternatePath(locale, recipe);
const copy = ui[locale];
---

<SiteLayout {locale} title={`${recipe.title} | ${settings.siteName}`} description={recipe.excerpt} {pathname} {alternatePath} settings={settings} image={recipe.image.src} preloadImages={[{ href: recipe.image.src }]}>
  <div class="recipe-page container section-space">
    <Breadcrumbs label={copy.recipe.breadcrumb} items={[{ label: copy.header.home, href: localizedPath(locale, 'home') }, { label: copy.header.recipes, href: localizedPath(locale, 'recipes') }, { label: recipe.title }]} />
    <RecipeArticle {recipe} {locale} />
  </div>
  <RecipeSuggestionsIsland server:defer {locale} currentRecipeId={recipe.id}>
    <div slot="fallback" class="card-skeleton" data-skeleton label={copy.recipe.latestTitle} title={copy.recipe.latestTitle} tone="muted" />
  </RecipeSuggestionsIsland>
</SiteLayout>

<style>.recipe-page { min-inline-size: 0; }</style>