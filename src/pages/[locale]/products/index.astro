---
import CatalogFilters from '@/components/catalog/CatalogFilters.astro';
import ProductGrid from '@/components/catalog/ProductGrid.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getBrands, getCategories, getGlobalSettings, getProducts } from '@/lib/cms/queries';
import { getApplicationOptions } from '@/lib/catalog/filter-products';
import { localizedPath } from '@/lib/i18n/routes';
import { counterpartLocale } from '@/lib/i18n/static-paths';
import { isLocale } from '@/lib/i18n/types';
import { ui } from '@/lib/i18n/ui';
import { loadCmsPageData, markNotFound } from '@/lib/cms/page-state';

const localeParam = Astro.params.locale;
if (!localeParam || !isLocale(localeParam)) {
  markNotFound(Astro.response);
  return Astro.rewrite('/404');
}
const locale = localeParam;
const pathname = localizedPath(locale, 'products');
const alternatePath = localizedPath(counterpartLocale(locale), 'products');
const pageData = await loadCmsPageData(
  () => getGlobalSettings(locale),
  () => getProducts(locale),
  () => getCategories(locale),
  () => getBrands(locale),
);
if (!pageData.ok) return Astro.rewrite('/503');
const [settings, products, categories, brands] = pageData.data;
const copy = ui[locale];
const applications = getApplicationOptions(products)
  .sort((first, second) => first.name.localeCompare(second.name));
---

<SiteLayout {locale} title={`${copy.catalog.title} | ${settings.siteName}`} description={copy.catalog.description} {pathname} {alternatePath} settings={settings}>
  <div class="catalog-page container section-space" data-catalog>
    <Breadcrumbs label={copy.product.breadcrumb} items={[{ label: copy.header.home, href: localizedPath(locale, 'home') }, { label: copy.header.products }]} />
    <header class="catalog-page__intro">
      <p>{copy.catalog.eyebrow}</p>
      <h1>{copy.catalog.title}</h1>
      <p>{copy.catalog.description}</p>
    </header>
    <CatalogFilters {categories} {brands} {applications} copy={copy.catalog} initialCount={products.length} />
    <ProductGrid {products} {locale} copy={copy.catalog} cardHeadingLevel="h2" />
  </div>
</SiteLayout>

<style>
  .catalog-page { min-inline-size: 0; }
  .catalog-page__intro { display: grid; gap: var(--space-5); grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr); padding-block: var(--space-6) var(--space-8); }
  .catalog-page__intro > p:first-child { color: var(--color-utility-grey); font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .catalog-page__intro h1 { font-size: var(--text-hero); max-inline-size: 12ch; }
  .catalog-page__intro > p:last-child { font-size: var(--text-lg); grid-column: 2; max-inline-size: var(--measure); }
  @media (max-width: 42rem) { .catalog-page__intro { grid-template-columns: minmax(0, 1fr); } .catalog-page__intro > p:last-child { grid-column: auto; } }
</style>
