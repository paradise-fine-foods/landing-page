---
import ProductDetail from '@/components/catalog/ProductDetail.astro';
import RelatedProductsIsland from '@/components/catalog/RelatedProductsIsland.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import CardSkeleton from '@/components/global/CardSkeleton.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { productAlternatePath, productDetailPath } from '@/lib/catalog/routes';
import { getGlobalSettings, getProductBySlug } from '@/lib/cms/queries';
import { localizedPath } from '@/lib/i18n/routes';
import { isLocale } from '@/lib/i18n/types';
import { ui } from '@/lib/i18n/ui';
import { loadCmsPageData, markNotFound } from '@/lib/cms/page-state';

const localeParam = Astro.params.locale;
const slug = Astro.params.slug;
if (!localeParam || !isLocale(localeParam) || !slug) {
  markNotFound(Astro.response);
  return Astro.rewrite('/404');
}
const locale = localeParam;
const pageData = await loadCmsPageData(
  () => getGlobalSettings(locale),
  () => getProductBySlug(locale, slug),
);
if (!pageData.ok) return Astro.rewrite('/503');
const [settings, product] = pageData.data;
if (!product) {
  markNotFound(Astro.response);
  return Astro.rewrite('/404');
}
const pathname = productDetailPath(locale, product);
const alternatePath = productAlternatePath(locale, product);
const copy = ui[locale];
---

<SiteLayout {locale} title={`${product.name} | ${settings.siteName}`} description={product.description} {pathname} {alternatePath} settings={settings} image={product.image.src}>
  <div class="product-page container section-space">
    <Breadcrumbs label={copy.product.breadcrumb} items={[{ label: copy.header.home, href: localizedPath(locale, 'home') }, { label: copy.header.products, href: localizedPath(locale, 'products') }, { label: product.name }]} />
    <ProductDetail {product} {copy} enquiryPath={localizedPath(locale, 'customerContact')} />
    <RelatedProductsIsland
      server:defer
      {locale}
      currentProductId={product.id}
      brandId={product.brand.id}
      categoryIds={product.categories.map(({ id }) => id)}
    >
      <CardSkeleton slot="fallback" label={copy.product.relatedTitle} title={copy.product.relatedTitle} inset />
    </RelatedProductsIsland>
  </div>
</SiteLayout>

<style>.product-page { min-inline-size: 0; }</style>
