---
import EnquiryForm from '@/components/forms/EnquiryForm.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getEnquiryModeCopy, isContactMode } from '@/lib/enquiry/modes';
import { getGlobalSettings, getProducts } from '@/lib/cms/queries';
import { localizedPath } from '@/lib/i18n/routes';
import { counterpartLocale } from '@/lib/i18n/static-paths';
import { isLocale } from '@/lib/i18n/types';
import { ui } from '@/lib/i18n/ui';
import { loadCmsPageData, markNotFound } from '@/lib/cms/page-state';

const localeParam = Astro.params.locale;
const modeParam = Astro.params.mode;
if (!localeParam || !isLocale(localeParam) || !isContactMode(modeParam)) {
  markNotFound(Astro.response);
  return Astro.rewrite('/404');
}
const locale = localeParam;
const mode = modeParam;
const routeKey = mode === 'customer' ? 'customerContact' : 'supplierContact';
const pathname = localizedPath(locale, routeKey);
const alternatePath = localizedPath(counterpartLocale(locale), routeKey);
const pageData = await loadCmsPageData(
  () => getGlobalSettings(locale),
  () => getProducts(locale),
);
if (!pageData.ok) return Astro.rewrite('/503');
const [settings, products] = pageData.data;
const copy = ui[locale];
const modeCopy = getEnquiryModeCopy(locale, mode);
---

<SiteLayout {locale} title={`${modeCopy.eyebrow} | ${settings.siteName}`} description={modeCopy.description} {pathname} {alternatePath} settings={settings}>
  <div class="contact-page container section-space">
    <Breadcrumbs label={copy.header.contact} items={[{ label: copy.header.home, href: localizedPath(locale, 'home') }, { label: copy.header.contact, href: localizedPath(locale, 'contact') }, { label: modeCopy.eyebrow }]} />
    <EnquiryForm {locale} {products} {copy} {mode} />
  </div>
</SiteLayout>
