---
import type { Product } from '../../lib/cms/types';
import type { Locale } from '../../lib/i18n/types';
import { getProductCardMetadata } from '../../lib/catalog/product-card';
import { localizedPath } from '../../lib/i18n/routes';
import { ui } from '../../lib/i18n/ui';
import Icon from '../global/Icon.astro';

interface Props { product: Product; locale: Locale; headingLevel?: 'h2' | 'h3' }
const { product, locale, headingLevel = 'h3' } = Astro.props;
const href = `${localizedPath(locale, 'products')}${product.slug}/`;
const Heading = headingLevel;
const categoryApplications = getProductCardMetadata(product, ui[locale].product.applicationNames);
---

<article class="product-card">
  <a class="product-card__media" href={href} tabindex="-1">
    <img src={product.image.src} width={product.image.width} height={product.image.height} alt={product.image.alt} loading="lazy" />
  </a>
  <div class="product-card__meta">
    <span>{product.brand.name}</span>
    <span>{product.packFormat}</span>
  </div>
  <Heading><a href={href}>{product.name}</a></Heading>
  <dl class="product-card__specs">
    {categoryApplications.length > 0 && <div><dt>{ui[locale].product.category}</dt><dd>{categoryApplications.join(' · ')}</dd></div>}
    <div><dt>{ui[locale].product.origin}</dt><dd>{product.origin}</dd></div>
    <div><dt>{ui[locale].product.storage}</dt><dd>{product.storage.label} · {product.storage.temperature}</dd></div>
  </dl>
  <a class="product-card__link" href={href}>{ui[locale].product.viewDetails}<Icon name="lucide:arrow-right" size="1.05em" /></a>
</article>

<style>
  .product-card { display: grid; gap: var(--space-3); }
  .product-card__media { aspect-ratio: 1 / 1; background: var(--color-cold-paper); border: 1px solid var(--color-brushed-steel); border-radius: var(--radius-sm); display: block; overflow: hidden; }
  .product-card__media img { block-size: 100%; inline-size: 100%; object-fit: contain; transition: opacity var(--transition-fast); }
  .product-card:hover .product-card__media img { opacity: 0.92; }
  .product-card__meta { border-block-start: 1px solid var(--color-brushed-steel); color: var(--color-utility-grey); display: flex; font-size: 0.68rem; font-weight: 600; justify-content: space-between; letter-spacing: var(--tracking-label); padding-block-start: var(--space-3); text-transform: uppercase; }
  .product-card h2 { font-size: var(--text-h2); }
  .product-card h3 { font-size: var(--text-h3); }
  .product-card :is(h2, h3) a { align-items: center; color: var(--color-graphite); display: flex; min-block-size: 2.75rem; text-decoration: none; }
  .product-card__specs { margin: 0; }
  .product-card__specs div { border-block-end: 1px solid var(--color-brushed-steel); display: grid; gap: var(--space-3); grid-template-columns: 5.5rem 1fr; padding-block: var(--space-2); }
  .product-card__specs dt { color: var(--color-utility-grey); font-size: 0.63rem; font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .product-card__specs dd { font-size: var(--text-xs); line-height: 1.45; }
  .product-card__link { align-items: center; color: var(--color-graphite); display: flex; font-size: var(--text-sm); font-weight: 600; justify-content: space-between; margin-block-start: auto; min-block-size: 2.75rem; padding-block-start: var(--space-2); text-decoration: none; }
</style>
