---
import { loadRelatedProducts } from '../../lib/catalog/related-products';
import type { Locale } from '../../lib/i18n/types';
import { ui } from '../../lib/i18n/ui';
import ProductGrid from './ProductGrid.astro';

interface Props {
  locale: Locale;
  currentProductId: string;
  brandId: string;
  categoryIds: string[];
}

const { locale, currentProductId, brandId, categoryIds } = Astro.props;
const products = await loadRelatedProducts(locale, {
  productId: currentProductId,
  brandId,
  categoryIds,
});
const copy = ui[locale];
---

{products.length > 0 && (
  <section class="related-products" aria-labelledby="related-products-title">
    <h2 id="related-products-title">{copy.product.relatedTitle}</h2>
    <ProductGrid {products} {locale} copy={copy.catalog} showEmptyState={false} />
  </section>
)}

<style>
  .related-products { border-block-start: 1px solid var(--color-brushed-steel); padding-block: var(--space-8); }
  .related-products > h2 { font-size: var(--text-h2); }
</style>
