---
import type { Product } from '../../lib/cms/types';
import type { UiCopy } from '../../lib/i18n/ui';
import Icon from '../global/Icon.astro';
import ProductMetadata from './ProductMetadata.astro';

interface Props {
  product: Product;
  copy: UiCopy;
  enquiryPath: string;
}

const { product, copy, enquiryPath } = Astro.props;
---

<article class="product-detail">
  <div class="product-detail__stage">
    <img src={product.image.src} width={product.image.width} height={product.image.height} alt={product.image.alt} loading="eager" fetchpriority="high" />
  </div>
  <div class="product-detail__content">
    <p class="product-detail__eyebrow">{product.brand.name} / {product.origin}</p>
    <h1>{product.name}</h1>
    <p class="product-detail__description">{product.description}</p>
    <ProductMetadata {product} copy={copy.product} />
    <div class="product-detail__lists">
      <section>
        <h2>{copy.product.applications}</h2>
        <ul>{product.applicationOptions.map(({ name }) => <li>{name}</li>)}</ul>
      </section>
      <section>
        <h2>{copy.product.benefits}</h2>
        <ul>{product.benefits.map((benefit) => <li>{benefit}</li>)}</ul>
      </section>
    </div>
    <a class="product-detail__enquire" href={`${enquiryPath}?product=${encodeURIComponent(product.id)}`}>{copy.product.enquire}<Icon name="lucide:arrow-right" size="1.05em" /></a>
  </div>
</article>

<style>
  .product-detail { display: grid; gap: clamp(var(--space-6), 6vw, var(--space-9)); grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr); padding-block: var(--space-7) var(--space-9); }
  .product-detail__stage { align-self: start; aspect-ratio: 1 / 1; background: var(--color-cold-paper); border: 1px solid var(--color-brushed-steel); border-radius: var(--radius-sm); overflow: hidden; position: sticky; inset-block-start: var(--space-5); }
  .product-detail__stage img { block-size: 100%; inline-size: 100%; object-fit: contain; }
  .product-detail__content { align-content: start; display: grid; gap: var(--space-5); }
  .product-detail__eyebrow { color: var(--color-utility-grey); font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .product-detail h1 { font-size: var(--text-h1); line-height: var(--leading-tight); }
  .product-detail__description { font-size: var(--text-lg); max-inline-size: var(--measure); }
  .product-detail__lists { display: grid; gap: var(--space-6); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .product-detail__lists h2 { font-family: var(--font-body); font-size: var(--text-sm); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .product-detail__lists ul { display: grid; gap: var(--space-2); margin-block-start: var(--space-3); padding-inline-start: 1.1rem; }
  .product-detail__enquire { align-items: center; background: var(--color-graphite); border: 1px solid var(--color-graphite); border-radius: var(--radius-md); color: var(--color-process-white); display: flex; font-weight: 600; justify-content: space-between; min-block-size: 3rem; padding: var(--space-4) var(--space-5); text-decoration: none; }
  @media (max-width: 48rem) { .product-detail { grid-template-columns: minmax(0, 1fr); } .product-detail__stage { position: relative; inset-block-start: auto; } .product-detail__facts { border-inline-start: 0; padding-inline-start: 0; } }
  @media (max-width: 28rem) { .product-detail__lists { grid-template-columns: minmax(0, 1fr); } }
</style>
