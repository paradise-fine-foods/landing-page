---
import type { Recipe } from '@/lib/cms/types';
import { formatRecipeDate, formatReadingTime } from '@/lib/recipes/presentation';
import type { Locale } from '@/lib/i18n/types';
import { ui } from '@/lib/i18n/ui';

interface Props {
  recipe: Recipe;
  locale: Locale;
}

const { recipe, locale } = Astro.props;
const copy = ui[locale].recipe;
---

<article class="recipe-article" data-recipe-article>
  <header class="recipe-article__header">
    <div><p class="eyebrow">{recipe.category}</p><h1>{recipe.title}</h1><p class="recipe-article__standfirst">{recipe.excerpt}</p></div>
    <dl class="recipe-article__label">
      <div><dt class="visually-hidden">{copy.publishedLabel}</dt><dd><time datetime={recipe.publishedAt}>{formatRecipeDate(locale, recipe.publishedAt)}</time></dd></div>
      <div><dt class="visually-hidden">{copy.readingTimeLabel}</dt><dd>{formatReadingTime(copy.readingTime, recipe.readingMinutes)}</dd></div>
      <div><dt class="visually-hidden">{copy.categoryLabel}</dt><dd>{recipe.category}</dd></div>
    </dl>
  </header>
  <figure class="recipe-article__visual"><img src={recipe.image.src} width={recipe.image.width} height={recipe.image.height} alt={recipe.image.alt} loading="eager" fetchpriority="high" /></figure>
  <div class="recipe-article__body" set:html={recipe.bodyHtml}></div>
</article>

<style>
  .recipe-article { min-inline-size: 0; }
  .recipe-article__header { display: grid; gap: clamp(var(--space-6), 7vw, var(--space-9)); grid-template-columns: minmax(0, 1fr) minmax(11rem, .25fr); padding-block: var(--space-7); }
  .recipe-article h1 { margin-block: var(--space-4); max-inline-size: 12ch; }
  .recipe-article__standfirst { font-family: var(--font-body); font-size: var(--text-xl); max-inline-size: 42ch; }
  .recipe-article__label { align-self: end; border-block: 1px solid var(--color-brushed-steel); display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); padding-block: var(--space-3); }
  .recipe-article__label div { padding-block: 0; }
  .recipe-article__label dd { font-size: var(--text-sm); font-weight: 600; }
  .recipe-article__visual { aspect-ratio: 16 / 8; background: var(--color-cold-paper); }
  .recipe-article__visual img { block-size: 100%; inline-size: 100%; object-fit: cover; }
  .recipe-article__body { display: grid; gap: var(--space-7); margin-inline: auto; max-inline-size: 46rem; padding-block: var(--space-8) var(--space-9); }
  .recipe-article__body :global(p:first-child) { font-family: var(--font-body); font-size: var(--text-lg); }
  @media (max-width: 42rem) { .recipe-article__header { grid-template-columns: minmax(0, 1fr); } .recipe-article__label { justify-self: start; } .recipe-article__visual { aspect-ratio: 4 / 3; } }
</style>