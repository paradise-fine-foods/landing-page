---
import type { Recipe } from '@/lib/cms/types';
import { recipeDetailPath } from '@/lib/recipes/routes';
import { formatRecipeDate, formatReadingTime } from '@/lib/recipes/presentation';
import type { Locale } from '@/lib/i18n/types';
import { ui } from '@/lib/i18n/ui';

interface Props {
  recipe: Recipe;
  locale: Locale;
  variant?: 'standard' | 'lead' | 'compact';
  headingLevel?: 'h2' | 'h3';
  showExcerpt?: boolean;
}

const { recipe: recipe, locale, variant = 'standard', headingLevel = 'h3', showExcerpt = true } = Astro.props;
const copy = ui[locale].recipe;
const Heading = headingLevel;
const href = recipeDetailPath(locale, recipe);
const storyLinkLabel = `${copy.readStory}: ${recipe.title}`;
const imageLoading = variant === 'lead' ? 'eager' : 'lazy';
---

<article class:list={['recipe-card', `recipe-card--${variant}`]}>
  <a class="recipe-card__image" href={href} aria-label={storyLinkLabel}>
    <img src={recipe.image.src} width={recipe.image.width} height={recipe.image.height} alt={recipe.image.alt} loading={imageLoading} decoding="async" />
  </a>
  <div class="recipe-card__copy">
    <div class="recipe-card__meta">
      <span>{recipe.category}</span>
      <time datetime={recipe.publishedAt}>{formatRecipeDate(locale, recipe.publishedAt)}</time>
      <span>{formatReadingTime(copy.readingTime, recipe.readingMinutes)}</span>
    </div>
    <Heading><a href={href}>{recipe.title}</a></Heading>
    {showExcerpt && <p>{recipe.excerpt}</p>}
    <a class="recipe-card__label" href={href} aria-label={storyLinkLabel}>{copy.readStory}<span aria-hidden="true"> →</span></a>
  </div>
</article>

<style>
  .recipe-card { border-block-start: 1px solid var(--color-brushed-steel); display: grid; min-inline-size: 0; }
  .recipe-card__image { aspect-ratio: 4 / 3; background: var(--color-cold-paper); display: block; }
  .recipe-card__image img { block-size: 100%; inline-size: 100%; object-fit: cover; }
  .recipe-card__copy { align-content: start; display: grid; gap: var(--space-4); padding: var(--space-5); }
  .recipe-card__meta { color: var(--color-deep-herb); display: flex; flex-wrap: wrap; font-size: var(--text-xs); font-weight: 600; gap: var(--space-2) var(--space-4); letter-spacing: .04em; text-transform: uppercase; }
  .recipe-card__meta span:first-child { color: var(--color-deep-herb); }
  .recipe-card h2 { font-size: var(--text-h2); }
  .recipe-card h3 { font-size: var(--text-h3); }
  .recipe-card h2 a, .recipe-card h3 a { align-items: center; display: flex; min-block-size: 2.75rem; text-decoration: none; }
  .recipe-card__label { align-items: center; color: var(--color-graphite); display: flex; font-size: var(--text-sm); font-weight: 600; inline-size: fit-content; margin-block-start: auto; min-block-size: 2.75rem; text-decoration: underline; text-decoration-color: var(--color-brushed-steel); text-underline-offset: .25em; }
  .recipe-card--lead { grid-column: 1 / -1; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, .8fr); }
  .recipe-card--lead .recipe-card__image { aspect-ratio: 4 / 3; }
  .recipe-card--lead .recipe-card__copy { align-content: center; padding: clamp(var(--space-6), 5vw, var(--space-8)); }
  .recipe-card--compact { grid-template-columns: 7rem minmax(0, 1fr); }
  .recipe-card--compact .recipe-card__image { aspect-ratio: 1; }
  .recipe-card--compact .recipe-card__copy { gap: var(--space-2); padding: var(--space-3); }
  .recipe-card--compact .recipe-card__label { display: none; }
  @media (max-width: 42rem) { .recipe-card--lead, .recipe-card--compact { grid-template-columns: minmax(0, 1fr); } .recipe-card--compact .recipe-card__image { aspect-ratio: 16 / 9; } }
</style>