---
import type { FeaturedContent } from '../../lib/cms/types';
import type { UiCopy } from '../../lib/i18n/ui';
import ButtonLink from '../global/ButtonLink.astro';

interface Props {
  copy: UiCopy['hero'];
  content: FeaturedContent['hero'];
  productsPath: string;
  contactPath: string;
}

const { copy, content, productsPath, contactPath } = Astro.props;
const { product } = content;
const metadata = [
  { label: copy.brand, value: product.brand.name },
  { label: copy.origin, value: product.origin },
  { label: copy.packFormat, value: product.packFormat },
  { label: copy.storage, value: `${product.storage.label} · ${product.storage.temperature}` },
];
---

<section class="living-hero" aria-labelledby="hero-title" data-living-hero>
  <div class="living-hero__content container">
    <div class="living-hero__copy">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1 id="hero-title">{content.title}</h1>
      <p class="living-hero__description">{content.body}</p>
      <div class="living-hero__actions">
        <ButtonLink href={productsPath}>{copy.primaryCta}</ButtonLink>
        <ButtonLink href={contactPath} variant="secondary">{copy.secondaryCta}</ButtonLink>
      </div>
      <dl class="living-hero__metadata">
        {metadata.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
    </div>
    <figure class="living-hero__art">
      <div class="living-hero__image-frame">
        <img
          src={content.image.src}
          alt={content.image.alt}
          width={content.image.width}
          height={content.image.height}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>{product.name}</figcaption>
    </figure>
  </div>
</section>

<script>
  const reduceMotion = globalThis.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? true;
  const controllers: Array<{ dispose(): void }> = [];
  let pageDisposed = false;

  globalThis.addEventListener('pagehide', (event) => {
    if ('persisted' in event && event.persisted) return;
    pageDisposed = true;
    for (const controller of controllers) controller.dispose();
  });

  import('../../lib/carousel/controller')
    .then(({ createCarousel }) => {
      if (pageDisposed) return;
      controllers.push(...[...document.querySelectorAll<HTMLElement>('[data-carousel]')]
        .map((carousel) => createCarousel(carousel, { reduceMotion })));
    })
    .catch(() => undefined);
</script>

<style>
  .living-hero { background: var(--color-process-white); border-block-end: 1px solid var(--color-brushed-steel); overflow: hidden; }
  .living-hero__content { display: grid; grid-template-columns: minmax(18rem, 4fr) minmax(30rem, 8fr); min-block-size: min(42rem, calc(100vh - 4.5rem)); }
  .living-hero__copy { align-self: center; display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-8) clamp(var(--space-6), 4vw, var(--space-8)) var(--space-8) 0; }
  .living-hero h1 { font-size: var(--text-hero); max-inline-size: 11ch; }
  .living-hero__description { max-inline-size: 34rem; }
  .living-hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-block-start: var(--space-2); }
  .living-hero__metadata { border-block-start: 2px solid var(--color-paradise-orange); display: grid; grid-template-columns: 1fr 1fr; margin: var(--space-3) 0 0; }
  .living-hero__metadata div { border-block-end: 1px solid var(--color-brushed-steel); min-inline-size: 0; padding: var(--space-3) var(--space-3) var(--space-3) 0; }
  .living-hero__metadata dt { color: var(--color-utility-grey); font-size: 0.7rem; font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .living-hero__metadata dd { font-size: 0.82rem; margin-block-start: var(--space-1); overflow-wrap: anywhere; }
  .living-hero__art { align-self: stretch; background: var(--color-cold-paper); border-inline: 1px solid var(--color-brushed-steel); display: grid; grid-template-rows: 1fr auto; margin: 0; min-inline-size: 0; position: relative; }
  .living-hero__image-frame { min-block-size: 36rem; overflow: hidden; position: relative; }
  .living-hero__image-frame > img { block-size: 100%; inline-size: 100%; object-fit: cover; position: absolute; }
  .living-hero__art figcaption { background: var(--color-graphite); color: var(--color-process-white); font-size: 0.78rem; font-weight: 600; letter-spacing: var(--tracking-label); padding: var(--space-3) var(--space-4); text-transform: uppercase; }
  @media (max-width: 64rem) { .living-hero__content { grid-template-columns: 1fr; } .living-hero__copy { padding-inline-end: 0; } .living-hero__art { border-block-start: 1px solid var(--color-brushed-steel); } }
  @media (max-width: 36rem) { .living-hero__content { inline-size: 100%; } .living-hero__copy { padding-inline: var(--container-inline); } .living-hero__actions { align-items: stretch; flex-direction: column; } .living-hero__art { background: var(--color-cold-paper); border-inline: 0; } .living-hero__image-frame { min-block-size: 30rem; } }
</style>
