---
import ButtonLink from '@/components/global/ButtonLink.astro';
interface Props { title: string; description: string; button: string; href: string }
const { title, description, button, href } = Astro.props;
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="container final-cta__shape">
    <div><h2 id="final-cta-title">{title}</h2><p>{description}</p></div>
    <ButtonLink {href} variant="secondary">{button}</ButtonLink>
  </div>
</section>

<style>
  .final-cta { background: var(--color-process-white); padding-block: var(--space-7) var(--space-9); }
  .final-cta__shape { align-items: center; background: var(--color-graphite); border: 1px solid var(--color-brushed-steel); border-radius: var(--radius-sm); color: var(--color-cold-paper); display: grid; gap: var(--space-6); grid-template-columns: 1fr auto; padding: clamp(var(--space-6), 6vw, var(--space-8)); }
  .final-cta h2 { font-size: var(--text-h2); }
  .final-cta h2 + p { margin-block-start: var(--space-2); max-inline-size: 42rem; }
  @media (max-width: 48rem) { .final-cta__shape { grid-template-columns: 1fr; } }
</style>
