---
import type { Brand } from '../../lib/cms/types';
import type { Locale } from '../../lib/i18n/types';
import { localizedPath } from '../../lib/i18n/routes';
import { ui } from '../../lib/i18n/ui';
import Icon from '../global/Icon.astro';

interface Props { brand: Brand; locale: Locale; index?: number; headingLevel?: 'h2' | 'h3' }
const { brand, locale, headingLevel = 'h3' } = Astro.props;
const href = `${localizedPath(locale, 'brands')}${brand.slug}/`;
const Heading = headingLevel;
const accentClasses: Record<Brand['accent'], string> = {
  butter: 'brand-card--butter',
  bordeaux: 'brand-card--bordeaux',
  'cold-chain': 'brand-card--blue',
};
---

<article class:list={['brand-card', accentClasses[brand.accent]]}>
  <a class="brand-card__media" href={href} tabindex="-1" aria-hidden="true">
    <img src={brand.image.src} width={brand.image.width} height={brand.image.height} alt="" loading="lazy" />
  </a>
  <div class="brand-card__copy">
    <p class="brand-card__origin">{brand.origin}</p>
    <Heading>{brand.name}</Heading>
    <p>{brand.description}</p>
  </div>
  <a class="brand-card__link" href={href}>{ui[locale].brand.viewBrand}<Icon name="lucide:arrow-up-right" size="1.05em" /></a>
</article>

<style>
  .brand-card { border-block-end: 1px solid var(--color-brushed-steel); display: grid; gap: var(--space-5); grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 1.2fr) minmax(9rem, 0.45fr); padding-block: var(--space-5); }
  .brand-card__media { aspect-ratio: 1 / 1; background: var(--color-cold-paper); border: 1px solid var(--color-brushed-steel); border-radius: var(--radius-sm); display: block; overflow: hidden; }
  .brand-card__media img { block-size: 100%; inline-size: 100%; object-fit: cover; }
  .brand-card__copy { align-content: center; }
  .brand-card__origin { color: var(--color-utility-grey); font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .brand-card :is(h2, h3) { font-size: var(--text-h3); margin-block: var(--space-2); }
  .brand-card__link { align-items: center; align-self: center; color: var(--color-graphite); display: flex; font-size: var(--text-sm); font-weight: 600; justify-content: space-between; min-block-size: 2.75rem; text-decoration: none; }
  @media (max-width: 42rem) { .brand-card { grid-template-columns: minmax(7rem, 0.6fr) minmax(0, 1fr); } .brand-card__link { grid-column: 1 / -1; } }
</style>
