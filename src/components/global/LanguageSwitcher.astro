---
import { ui } from '@/lib/i18n/ui';
import type { Locale } from '@/lib/i18n/types';
import Icon from '@/components/global/Icon.astro';

interface Props {
  currentPath: string;
  alternatePath: string;
  locale: Locale;
}

const { currentPath, alternatePath, locale } = Astro.props;
const targetLocales: Record<Locale, Locale> = { en: 'vi', vi: 'en' };
const targetLocale = targetLocales[locale];
---

<a
  class="language-switcher"
  href={alternatePath}
  hreflang={targetLocale}
  lang={targetLocale}
  data-current-path={currentPath}
>
  <Icon name="lucide:globe-2" size="1em" />
  <span aria-hidden="true">{targetLocale.toUpperCase()}</span>
  <span class="language-switcher__name">{ui[locale].header.language}</span>
</a>

<style>
  .language-switcher {
    align-items: center;
    border-radius: var(--radius-sm);
    color: inherit;
    display: inline-flex;
    font-size: var(--text-sm);
    gap: var(--space-1);
    min-block-size: 2.75rem;
    text-decoration: none;
  }

  .language-switcher span {
    border: 1px solid var(--color-brushed-steel);
    border-radius: var(--radius-sm);
    font-size: 0.625rem;
    line-height: 1;
    padding: 0.28rem;
  }

  .language-switcher .language-switcher__name { border: 0; padding: 0; }

  @media (max-width: 48rem) {
    .language-switcher__name { display: none; }
  }
</style>
